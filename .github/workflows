# 补全 yml 的专属补丁
$ProjectDir = "F:\123\app_for_personal_use_not_for_public-main"
$YamlDir = "$ProjectDir\.github\workflows"

# 确保隐藏目录存在
if (-not (Test-Path $YamlDir)) {
    New-Item -ItemType Directory -Path $YamlDir -Force | Out-Null
}

$yamlCode = @"
name: Build QG ReShade Engine

on:
  push:
    branches: [ "main" ]
  workflow_dispatch:

jobs:
  build:
    runs-on: ubuntu-latest

    steps:
    - name: Checkout Source
      uses: actions/checkout@v4

    - name: Set up JDK 17
      uses: actions/setup-java@v4
      with:
        java-version: '17'
        distribution: 'temurin'

    - name: Setup Android NDK (For C++ Core)
      uses: nttld/setup-ndk@v1
      with:
        ndk-version: r25b

    - name: Force Gradle 8.1.1
      run: |
        wget https://services.gradle.org/distributions/gradle-8.1.1-bin.zip
        unzip -q gradle-8.1.1-bin.zip
        echo "`$PWD/gradle-8.1.1/bin" >> `$GITHUB_PATH

    - name: Build with Gradle
      run: gradle assembleDebug

    - name: Upload APK
      uses: actions/upload-artifact@v4
      with:
        name: QGReShadeEngine-APK
        path: app/build/outputs/apk/debug/app-debug.apk
"@

[System.IO.File]::WriteAllText("$YamlDir\build.yml", $yamlCode, [System.Text.UTF8Encoding]::new($false))
Write-Host "✅ 傻乎乎的鱼鱼把 build.yml 补齐啦！路径: $YamlDir" -ForegroundColor Green
